# ============================================
# Auto-Workflow Configuration
# Copy this file to .env and fill in your values
# ============================================

# --- Flask ---
FLASK_PORT=5050
FLASK_DEBUG=false

# --- Odoo ---
ODOO_URL=https://www.bonario-portal.com
ODOO_DB=bonario-vietnam
ODOO_UID=145
ODOO_API_KEY=your_odoo_api_key_here

# --- Shopify (Ordinaire) ---
SHOPIFY_STORE=ordinaire-vietnam.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_token_here
SHOPIFY_ODOO_COMPANY_ID=11
SHOPIFY_ODOO_SALESPERSON_ID=6
SHOPIFY_ODOO_SALES_TEAM_ID=15
SHOPIFY_ODOO_SOURCE_ID=46

# --- Shopify (Bonario) ---
BONARIO_SHOPIFY_STORE=56562d-2.myshopify.com
BONARIO_SHOPIFY_ACCESS_TOKEN=shpat_your_token_here
BONARIO_ODOO_COMPANY_ID=1
BONARIO_ODOO_SALESPERSON_ID=6
BONARIO_ODOO_SALES_TEAM_ID=17
BONARIO_ODOO_SOURCE_ID=40

# --- Zalo ZNS (App ORD = Ordinaire) ---
ZALO_APP_ID=2163459737026406066
ZALO_SECRET_KEY=your_zalo_secret_key_here
ZALO_REDIRECT_URI=https://bonstu.site/webhook/zns-done

# --- Zalo ZNS (App BON = Bonario) ---
ZALO_BON_APP_ID=29644118971927106
ZALO_BON_SECRET_KEY=your_zalo_bon_secret_key_here

# --- Telegram (RFID Bot) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=587193310

# --- Auto-Conducted (Meeting Tick) ---
CONDUCTED_ODOO_UID=145
CONDUCTED_ODOO_API_KEY=your_conducted_api_key_here

# --- Deadline Watcher ---
DEADLINE_POLL_INTERVAL=60

# --- CRM Lost Watcher ---
CRM_POLL_INTERVAL=90

# --- Completion Days Dashboard (Weekly Refresh) ---
# Dashboard "ORD - Số ngày chốt đơn hàng" — refreshed every Monday 08:00 ICT
COMPLETION_DAYS_DASHBOARD_ID=278
COMPLETION_DAYS_ENABLED=true

# --- Dashboard 259 Approval (Monthly Refresh) ---
# Dashboard "Approval" — refreshed on 1st of each month at 06:00 ICT
DASHBOARD_259_ID=259
DASHBOARD_259_APPROVAL_TYPE_ID=13
DASHBOARD_259_ENABLED=true
# Separate UID for approval queries (uses a different API key)
DASHBOARD_259_ODOO_UID=
DASHBOARD_259_ODOO_API_KEY=

# --- KHO MAU CTL Overdue (Daily) ---
# Scans stock.picking for overdue CTL loans, creates mail.activity at D30/60/90
CTL_ENABLED=true
CTL_PICKING_TYPE_ID=230
CTL_LOCATION_ID=63
CTL_USER_ID=218
CTL_ACTIVITY_TYPE_NAME=CTL - Phiếu mượn quá hạn
CTL_LENDING_MIN_DATE=2026-01-01

# --- Checklist Overdue (Monthly) ---
# Counts overdue activities (type 108) per SC user, writes to dashboard D69
CHECKLIST_OVERDUE_ENABLED=true
CHECKLIST_ACTIVITY_TYPE_ID=108

# --- Dashboard 247 SC Activities (Monthly) ---
# "SCM - Hoạt động trễ hạn (v2)" — refreshed on 1st of each month at 06:00 ICT
DASHBOARD_247_ID=271
DASHBOARD_247_ENABLED=true

# --- Section 3 Timeline (Monthly) ---
# Updates "Tỷ lệ request xử lý trễ hạn" table on individual dashboards 265/268/269
SECTION3_TIMELINE_ENABLED=true

# --- Section 5.2 SO-to-FSM Violations (Monthly) ---
# Updates "SO-to-DVHT timing violations" table on individual dashboards 265/268/269
SECTION5_2_ENABLED=true

# --- Commission Revenue (Polling, replaces Odoo automation 64) ---
# Polls sale.order every 60s, recalculates commission revenue fields
COMMISSION_REVENUE_ENABLED=true
COMMISSION_REVENUE_POLL_INTERVAL=60
# Product category IDs excluded from commission base (comma-separated)
COMMISSION_REVENUE_EXCLUDED_CATEGORIES=19,998,999,1097,1173,1174
# Product name prefixes (pipe-separated) excluded from commission base.
# Matches if product display_name STARTS WITH any prefix.
# Use for products inside shared categories that should be excluded individually.
COMMISSION_REVENUE_EXCLUDED_NAME_PREFIXES=C-MOTOR-THI CÔNG LẮP ĐẶT|C-MOTOR-THI CÔNG LẮP ĐẶT (THÔNG TẦNG)|C-MOTOR-THI CÔNG LẮP ĐẶT TĨNH|C-MOTOR-THI CÔNG LẮP ĐẶT ĐỘNG CƠ|C-MOTOR-SOMPY-THI CÔNG LẮP ĐẶT ĐỘNG CƠ|CTL

# --- OP Delivery Date Sync (Polling, replaces Odoo automation 80) ---
# Polls sale.order every 60s, syncs x_studio_op_tin_d_kin to picking scheduled_date
OP_DELIVERY_DATE_ENABLED=true
OP_DELIVERY_DATE_POLL_INTERVAL=60

# --- Approval Document Number (Webhook, replaces Odoo automation 36) ---
# Receives webhook from Odoo approval.request on_save, generates document number
APPROVAL_DOC_NUMBER_ENABLED=true
APPROVAL_DOC_SEQUENCE_CODE=approval.banhanh
APPROVAL_DOC_FALLBACK_NUM=00000
# Polling fallback interval (catches records webhook misses)
APPROVAL_DOC_POLL_INTERVAL=30

# --- Follow Activity on Order State Change (Polling, new automation) ---
# Creates Follow activities when sale.order changes to specific order states
FOLLOW_ACTIVITY_ENABLED=true
FOLLOW_ACTIVITY_POLL_INTERVAL=30
# Comma-separated trigger values (must match x_studio_selection_field_q4_1imrcsjj8 selection)
FOLLOW_ACTIVITY_TRIGGER_VALUES=Hàng về/Chờ thi công
# Activity type ID (72 = Follow)
FOLLOW_ACTIVITY_TYPE_ID=72
# Fixed user IDs to notify for every company: 237=Hoàng Thị Ngọc Bích, 253=Nguyễn Quỳnh Như
FOLLOW_ACTIVITY_FIXED_USER_IDS=237,253
# Company-specific recipient: 1 (Bonario)=218 Ngô Trọng Cả, 11 (Ordinaire)=9 Phan Minh Tuấn
FOLLOW_ACTIVITY_COMPANY_USER_IDS=1:218,11:9
# Deadline days from today for the follow activity
FOLLOW_ACTIVITY_DEADLINE_DAYS=2

# --- Return Activity (Polling) ---
# When a return picking is created (return_id set), create activity on that picking.
# Scope: incoming + internal returns. Assignee: BON SC, TRẦN THIỆN NHÂN (uid 295).
RETURN_ACTIVITY_ENABLED=true
RETURN_ACTIVITY_POLL_INTERVAL=5
RETURN_ACTIVITY_USER_IDS=295,293
RETURN_ACTIVITY_SUMMARY=Return mới cần xem
RETURN_ACTIVITY_TYPE_ID=4
RETURN_ACTIVITY_DEADLINE_DAYS=0
RETURN_ACTIVITY_PICKING_CODES=incoming,internal

# --- Odoo Test Server (testing0808.odoo.com) ---
# Used by Lot/Serial automation. Completely separate from production Odoo above.
ODOO_TEST_URL=https://testing0808.odoo.com
ODOO_TEST_DB=testing0808
ODOO_TEST_UID=
ODOO_TEST_API_KEY=

# --- Lot/Serial Automation ---
# Comma-separated warehouse codes where serial rename is allowed
LOT_SERIAL_WHITELIST_WAREHOUSES=ORDST,ORDAP
# Source warehouses permitted to replace a temporary serial with a scanned one
LOT_SERIAL_SOURCE_WAREHOUSES=MID
# Keep false until the test credentials and a dedicated API token are configured.
LOT_SERIAL_ENABLED=false
LOT_SERIAL_API_TOKEN=replace-with-a-long-random-token
# Allows the explicit /lot-serial/setup endpoint to create two custom stock.lot fields.
LOT_SERIAL_ALLOW_SCHEMA_SETUP=false
